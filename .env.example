# This is a reference; SilverTrap reads process environment variables, not .env files.
SILVERTRAP_DATA_DIR=./data
SILVERTRAP_HOST=127.0.0.1
SILVERTRAP_PORT=8787

# Optional: a persistent code of at least 32 random characters. Otherwise generated locally.
# SILVERTRAP_OPERATOR_TOKEN=

# Optional: already installed LOCAL Ollama model. Off by default. No downloads are automatic.
# SILVERTRAP_OLLAMA_MODEL=your-installed-local-model

# Optional: secret for a dedicated signed intake adapter. Off by default. No delivery adapter.
# SILVERTRAP_WEBHOOK_SECRET=
